#include <windows.h>
#include "version.h"
1 ICON "app.ico"
2 RCDATA "logo.png"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
 FILEVERSION 0,1,1,0
 PRODUCTVERSION 0,1,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "PAF-Videos native media player\0"
   VALUE "FileVersion", PAF_VERSION "\0"
   VALUE "ProductName", "PAF-Videos\0"
   VALUE "ProductVersion", PAF_VERSION "\0"
   VALUE "LegalCopyright", "Copyright (c) 2026 Lyvt-Dev\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
